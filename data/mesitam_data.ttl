@prefix : <http://mesitam.ac.in/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes ###
:Department a rdfs:Class .
:Faculty a rdfs:Class .
:Course a rdfs:Class .
:Regulation a rdfs:Class .

### Properties ###
:hasName a rdf:Property ;
    rdfs:domain :Department ;
    rdfs:range xsd:string .

:abbreviation a rdf:Property ;
    rdfs:domain :Department ;
    rdfs:range xsd:string .

:hasHOD a rdf:Property ;
    rdfs:domain :Department ;
    rdfs:range :Faculty .

:teaches a rdf:Property ;
    rdfs:domain :Faculty ;
    rdfs:range :Course .

:belongsTo a rdf:Property ;
    rdfs:domain :Faculty ;
    rdfs:range :Department .

:hasDesignation a rdf:Property ;
    rdfs:domain :Faculty ;
    rdfs:range xsd:string .

:hasCredit a rdf:Property ;
    rdfs:domain :Course ;
    rdfs:range xsd:integer .

:governedBy a rdf:Property ;
    rdfs:domain :Course ;
    rdfs:range :Regulation .

### Data - Departments ###
:CSE a :Department ;
    :hasName "Computer Science and Engineering" ;
    :abbreviation "CSE" ;
    :hasHOD :Dr_Anitha .

:ECE a :Department ;
    :hasName "Electronics and Communication Engineering" ;
    :abbreviation "ECE" ;
    :hasHOD :Dr_Rajesh .

:ME a :Department ;
    :hasName "Mechanical Engineering" ;
    :abbreviation "ME" ;
    :hasHOD :Dr_Suresh .

### Data - Faculty ###
:Dr_Anitha a :Faculty ;
    :hasName "Dr. Anitha S" ;
    :hasDesignation "Professor & HOD" ;
    :belongsTo :CSE ;
    :teaches :CS301, :CS401 .

:Prof_Rahul a :Faculty ;
    :hasName "Prof. Rahul K" ;
    :hasDesignation "Assistant Professor" ;
    :belongsTo :CSE ;
    :teaches :CS304 .

:Dr_Rajesh a :Faculty ;
    :hasName "Dr. Rajesh Kumar" ;
    :hasDesignation "Professor & HOD" ;
    :belongsTo :ECE .

### Data - Courses ###
:CS301 a :Course ;
    :hasName "Theory of Computation" ;
    :abbreviation "CS301" ;
    :hasCode "CST301" ;
    :hasCredit 4 ;
    :governedBy :KTU_2019_Scheme .

:CS304 a :Course ;
    :hasName "Computer Graphics" ;
    :abbreviation "CS304" ;
    :hasCode "CST304" ;
    :hasCredit 4 .

### Data - Regulations (KTU) ###
:KTU_Attendance_Rule a :Regulation ;
    :hasName "Minimum Attendance" ;
    :description "A student must have a minimum of 75% attendance to draft the final exam. Condoation is allowed twice during the course." .

:KTU_Credit_System a :Regulation ;
    :hasName "B.Tech Credit Requirements" ;
    :description "Total credits required for B.Tech degree is 160. Honours requires an additional 20 credits." .

:Duty_Leave_Policy a :Regulation ;
    :hasName "Duty Leave" ;
    :description "Duty leave is granted for students participating in university-level events. Maximum 10 days per semester." .

